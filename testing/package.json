{
  "name": "@yadad/testing",
  "version": "0.16.5",
  "description": "yadad mock registry, source states, state checks, component contract test kit and focus contract kit.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@yadad/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contract-kit": {
      "@yadad/source": "./src/contract-kit.tsx",
      "types": "./dist/contract-kit.d.ts",
      "default": "./dist/contract-kit.js"
    },
    "./state-checks": {
      "@yadad/source": "./src/state-checks.tsx",
      "types": "./dist/state-checks.d.ts",
      "default": "./dist/state-checks.js"
    },
    "./focus-kit": {
      "@yadad/source": "./src/focus-kit.tsx",
      "types": "./dist/focus-kit.d.ts",
      "default": "./dist/focus-kit.js"
    }
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md",
    "!**/*.test.*",
    "!**/*.tsbuildinfo"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/aggressive-stag/yadad.git",
    "directory": "testing"
  },
  "dependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@yadad/core": "workspace:*",
    "@yadad/runtime": "workspace:*",
    "axe-core": "^4.13.0"
  },
  "peerDependencies": {
    "jsdom": "~30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vitest": "^5.0.3"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "~30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vitest": "^5.0.3"
  }
}
