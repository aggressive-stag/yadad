{
  "name": "@yadad/editor",
  "version": "0.1.3",
  "description": "yadad editor: patch-based editing of documents, dashboard layout and entity fields.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@yadad/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!**/*.test.*",
    "!**/*.tsbuildinfo"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/aggressive-stag/yadad.git",
    "directory": "packages/editor"
  },
  "dependencies": {
    "@yadad/core": "workspace:*",
    "@yadad/runtime": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@yadad/testing": "workspace:*",
    "jsdom": "~30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
