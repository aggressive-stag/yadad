{
  "kind": "table",
  "specVersion": 6,
  "id": "events",
  "entity": "event",
  "revision": 1,
  "dataSource": "default",
  "columns": [{ "field": "happened_at" }, { "field": "kind" }, { "field": "title" }, { "field": "reviewed_at" }],
  "sort": [{ "field": "happened_at", "dir": "desc" }],
  "quickFilters": [{ "field": "happened_at" }, { "field": "kind" }],
