{
  "name": "yadad",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "depcruise": "depcruise --config .dependency-cruiser.ts packages testing apps examples",
    "depcruise:fixture": "node tools/forbidden-import-fixture/check.ts",
    "describe-registry": "node tools/describe-registry.ts",
    "record-schema": "node tools/record-schema.ts",
    "test": "vitest run && node --test \"examples/starter/server/*.test.ts\"",
    "lint": "eslint --flag unstable_native_nodejs_ts_config .",
    "changeset": "changeset",
    "api:check": "node tools/api-report.ts",
    "api:update": "node tools/api-report.ts --update",
    "size": "pnpm --filter @yadad/example-starter build && size-limit"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "7.60.1",
    "@size-limit/preset-app": "14.3.0",
    "@types/node": "^22.20.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^10.12.0",
    "size-limit": "14.3.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
