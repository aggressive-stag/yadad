{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "../../node_modules/.cache/example-starter-tsc/out",
    "tsBuildInfoFile": "../../node_modules/.cache/example-starter-tsc/tsbuildinfo",
    "emitDeclarationOnly": true,
    "declarationMap": false,
    "sourceMap": false,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["vite/client", "node"]
  },
  "include": ["src", "tests", "scripts", "server", "vite.config.ts"],
  "references": [
    { "path": "../../packages/core" },
    { "path": "../../packages/runtime" },
    { "path": "../../packages/renderer" },
    { "path": "../../packages/theme" },
    { "path": "../../testing" }
  ]
}
